DATABASE_URL=postgresql://elsystar:elsystar@localhost:5432/elsystar
NEXT_PUBLIC_SITE_URL=http://localhost:6300
NEXT_PUBLIC_ADMIN_URL=http://localhost:6301

# Bootstrap-доступ в административную панель.
# Перед production замените значения на уникальные секреты.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# Не менее 32 случайных символов. Используется для подписи admin session cookie.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Отдельный случайный секрет для HMAC-ключей rate limiting / приватизации IP.
SECURITY_HASH_SECRET=replace-with-another-long-random-secret

# SEO / indexing. Preview и Codespaces должны оставаться false.
# На реальном HTTPS-домене включить только после проверки sitemap/robots/redirects.
SEO_INDEXING_ENABLED=false
# Необязательные meta verification tokens. Можно использовать DNS verification вместо них.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Необязательно: каталог локальных backup-файлов.
# ELSYSTAR_BACKUP_DIR=/var/backups/elsystar
