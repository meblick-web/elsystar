{
  "name": "ELSYSTAR Cloud Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [6300, 6301],
  "portsAttributes": {
    "6300": {
      "label": "ELSYSTAR Public Site",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "6301": {
      "label": "ELSYSTAR Admin",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "16300": {
      "label": "ELSYSTAR Web Internal",
      "protocol": "http",
      "onAutoForward": "ignore"
    },
    "16301": {
      "label": "ELSYSTAR Admin Internal",
      "protocol": "http",
      "onAutoForward": "ignore"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",
  "postStartCommand": "bash .devcontainer/start-preview.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
