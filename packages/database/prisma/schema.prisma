generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
  SUPPORT
  ANALYST
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentType {
  MANUAL
  CERTIFICATE
  SOFTWARE
  FIRMWARE
  SCHEME
  PASSPORT
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  CLOSED
  SPAM
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  DOCUMENT_DOWNLOAD
  CTA_CLICK
  LEAD_SUBMIT
  PHONE_CLICK
  EMAIL_CLICK
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         AdminRole  @default(EDITOR)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ProductCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  model           String                 @unique
  name            String
  shortDescription String
  description     String?
  status          ProductStatus          @default(DRAFT)
  featured        Boolean                @default(false)
  sortOrder       Int                    @default(0)
  seoTitle        String?
  seoDescription  String?
  categoryId      String?
  category        ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  specifications  ProductSpecification[]
  documents       Document[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, sortOrder])
  @@index([categoryId])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  unit      String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model Document {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        DocumentType
  fileUrl     String
  fileName    String
  version     String?
  language    String       @default("ru")
  publishedAt DateTime?
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type, publishedAt])
  @@index([productId])
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  company    String?
  email      String?
  phone      String?
  message    String?
  productId  String?
  sourcePath String?
  referrer   String?
  source     String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  visitorId  String
  sessionId  String?
  path       String
  productId  String?
  documentId String?
  referrer   String?
  source     String?
  device     String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([productId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail, createdAt])
}
