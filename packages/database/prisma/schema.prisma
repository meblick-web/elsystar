generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
  SUPPORT
  ANALYST
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductRelationType {
  COMPATIBLE
  ACCESSORY
  ALTERNATIVE
  RELATED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SolutionType {
  SOLUTION
  PLATFORM
}

enum DocumentType {
  MANUAL
  CERTIFICATE
  SOFTWARE
  FIRMWARE
  SCHEME
  PASSPORT
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

enum CorporateMediaSection {
  ABOUT
  PRODUCTION
  CONTACTS
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  CLOSED
  SPAM
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  DOCUMENT_DOWNLOAD
  CTA_CLICK
  LEAD_SUBMIT
  PHONE_CLICK
  EMAIL_CLICK
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         AdminRole  @default(EDITOR)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model HomepageContent {
  id                 String   @id @default("homepage")
  heroEyebrow        String   @default("ИНТЕЛЛЕКТУАЛЬНЫЕ ТРАНСПОРТНЫЕ СИСТЕМЫ")
  heroTitle          String   @default("Контроллеры и системы управления дорожным движением")
  heroDescription    String   @default("Разрабатываем оборудование и программные решения для безопасного и эффективного управления городской транспортной инфраструктурой.")
  primaryCtaLabel    String   @default("Подобрать решение")
  primaryCtaHref     String   @default("/solutions")
  secondaryCtaLabel  String   @default("Каталог продукции")
  secondaryCtaHref   String   @default("/products")
  trust1Value        String   @default("30+")
  trust1Label        String   @default("лет инженерного опыта")
  trust2Value        String   @default("Собственное")
  trust2Label        String   @default("производство оборудования")
  trust3Value        String   @default("Комплексно")
  trust3Label        String   @default("от контроллера до АСУДТ")
  productsEyebrow    String   @default("ПРОДУКЦИЯ")
  productsTitle      String   @default("Основные контроллеры")
  solutionsEyebrow   String   @default("НАПРАВЛЕНИЯ")
  solutionsTitle     String   @default("Всё необходимое для управления движением")
  projectsEyebrow    String   @default("ПРОЕКТЫ")
  projectsTitle      String   @default("Решения, работающие на реальных объектах")
  supportEyebrow     String   @default("ПОДДЕРЖКА")
  supportTitle       String   @default("Документы и помощь — в одном месте")
  supportDescription String   @default("Быстрый доступ к руководствам, сертификатам, ПО и актуальным версиям материалов.")
  requestEyebrow     String   @default("СВЯЗАТЬСЯ С НАМИ")
  requestTitle       String   @default("Получить коммерческое предложение")
  requestDescription String  @default("Оставьте задачу и контакты. Обращение попадёт в панель управления вместе с источником перехода и страницей, с которой оно было отправлено.")
  updatedAt          DateTime @updatedAt
}

model CorporateContent {
  id                  String                     @id @default("corporate")
  companyName         String                     @default("ООО «Элсистар»")
  aboutEyebrow        String                     @default("О КОМПАНИИ")
  aboutTitle          String                     @default("Инженерные решения для управления дорожным движением")
  aboutLead           String                     @default("ООО «Элсистар» — производитель программируемых контроллеров и сервисного оборудования управления дорожным движением.")
  aboutBody           String?
  historyTitle        String                     @default("Опыт разработки и внедрения")
  historyBody         String?
  productionEyebrow   String                     @default("ПРОИЗВОДСТВО")
  productionTitle     String                     @default("Собственное производство оборудования")
  productionLead      String                     @default("Компания располагает собственными производственными мощностями для выпуска дорожных контроллеров и оборудования АСУДД.")
  productionBody      String?
  competenciesTitle   String                     @default("Ключевые компетенции")
  supportTitle        String                     @default("Техническая поддержка")
  supportBody         String?
  phonePrimary        String?                    @default("+7 (967) 423-20-54")
  phoneSecondary      String?                    @default("8 (86635) 41034")
  emailPrimary        String?                    @default("arkhast@mail.ru")
  address             String?
  workingHours        String?
  legalName           String?                    @default("ООО «Элсистар»")
  inn                 String?
  kpp                 String?
  ogrn                 String?
  competencies        CorporateCompetency[]
  mediaPlacements     CorporateMediaPlacement[]
  updatedAt           DateTime                   @updatedAt
}

model CorporateCompetency {
  id          String           @id @default(cuid())
  contentId   String           @default("corporate")
  title       String
  description String?
  sortOrder   Int              @default(0)
  content     CorporateContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([contentId, sortOrder])
}

model CorporateMediaPlacement {
  id           String                @id @default(cuid())
  contentId    String                @default("corporate")
  mediaAssetId String
  section      CorporateMediaSection
  caption      String?
  sortOrder    Int                   @default(0)
  content      CorporateContent      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset            @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())

  @@unique([contentId, mediaAssetId, section])
  @@index([contentId, section, sortOrder])
  @@index([mediaAssetId])
}

model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model ProductCategory {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  sortOrder   Int               @default(0)
  parentId    String?
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([parentId, sortOrder])
}

model Product {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  model             String                 @unique
  name              String
  shortDescription  String
  description       String?
  status            ProductStatus          @default(DRAFT)
  featured          Boolean                @default(false)
  sortOrder         Int                    @default(0)
  seoTitle          String?
  seoDescription    String?
  categoryId        String?
  category          ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  specifications    ProductSpecification[]
  features          ProductFeature[]
  configurations    ProductConfiguration[]
  documents         Document[]
  documentSeries    DocumentSeries[]
  mediaAssets       MediaAsset[]
  leads             Lead[]
  projects          Project[]
  solutions         Solution[]             @relation("ProductSolutions")
  outgoingRelations ProductRelation[]      @relation("ProductRelationSource")
  incomingRelations ProductRelation[]      @relation("ProductRelationTarget")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status, sortOrder])
  @@index([categoryId, status, sortOrder])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  unit      String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductFeature {
  id          String   @id @default(cuid())
  productId   String
  title       String
  description String?
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductConfiguration {
  id          String   @id @default(cuid())
  productId   String
  name        String
  description String?
  sku         String?
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductRelation {
  id              String              @id @default(cuid())
  sourceProductId String
  targetProductId String
  type            ProductRelationType @default(RELATED)
  sortOrder       Int                 @default(0)
  sourceProduct   Product             @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct   Product             @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())

  @@unique([sourceProductId, targetProductId, type])
  @@index([sourceProductId, type, sortOrder])
  @@index([targetProductId])
}

model Solution {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  description      String?
  type             SolutionType  @default(SOLUTION)
  status           ContentStatus @default(DRAFT)
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  imageUrl         String?
  seoTitle         String?
  seoDescription   String?
  projects         Project[]
  products         Product[]     @relation("ProductSolutions")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([type, status])
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  city           String?
  region         String?
  year           Int?
  challenge      String?
  solutionText   String?
  result         String?
  coverImageUrl  String?
  isDemo         Boolean       @default(false)
  metric1Value   String?
  metric1Label   String?
  metric2Value   String?
  metric2Label   String?
  metric3Value   String?
  metric3Label   String?
  status         ContentStatus @default(DRAFT)
  featured       Boolean       @default(false)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  products       Product[]
  solutions      Solution[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([year])
  @@index([isDemo, status])
}

model DocumentSeries {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  type        DocumentType
  language    String       @default("ru")
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  versions    Document[]
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type, language, sortOrder])
  @@index([productId, type])
}

model Document {
  id             String          @id @default(cuid())
  title          String
  description    String?
  type           DocumentType
  fileUrl        String
  fileName       String
  version        String?
  language       String          @default("ru")
  mimeType       String?
  fileSize       Int?
  checksumSha256 String?
  releaseNotes   String?
  releaseDate    DateTime?
  isCurrent      Boolean         @default(false)
  isPublic       Boolean         @default(true)
  publishedAt    DateTime?
  sortOrder      Int             @default(0)
  seriesId       String?
  series         DocumentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([seriesId, version])
  @@index([type, publishedAt])
  @@index([productId])
  @@index([isPublic, publishedAt])
  @@index([seriesId, isCurrent, releaseDate])
}

model MediaAsset {
  id                    String                     @id @default(cuid())
  title                 String
  alt                   String?
  type                  MediaType                  @default(IMAGE)
  url                   String
  storageProvider       String                     @default("external")
  storageKey            String?
  mimeType              String?
  fileSize              Int?
  width                 Int?
  height                Int?
  productId             String?
  product               Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  isPrimary             Boolean                    @default(false)
  sortOrder             Int                        @default(0)
  corporatePlacements   CorporateMediaPlacement[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([type, createdAt])
  @@index([productId, isPrimary, sortOrder])
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  message     String?
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourcePath  String?
  referrer    String?
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  visitorId  String
  sessionId  String?
  path       String
  productId  String?
  documentId String?
  referrer   String?
  source     String?
  device     String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([productId, createdAt])
  @@index([source, createdAt])
  @@index([device, createdAt])
  @@index([sessionId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([entityType, createdAt])
}

model SeoRoute {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  canonical   String?
  indexable   Boolean  @default(true)
  follow      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([indexable, updatedAt])
}

model RedirectRule {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  status    Int      @default(301)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, updatedAt])
}
