generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
  SUPPORT
  ANALYST
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductRelationType {
  COMPATIBLE
  ACCESSORY
  ALTERNATIVE
  RELATED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SolutionType {
  SOLUTION
  PLATFORM
}

enum DocumentType {
  MANUAL
  CERTIFICATE
  SOFTWARE
  FIRMWARE
  SCHEME
  PASSPORT
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  CLOSED
  SPAM
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  DOCUMENT_DOWNLOAD
  CTA_CLICK
  LEAD_SUBMIT
  PHONE_CLICK
  EMAIL_CLICK
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         AdminRole  @default(EDITOR)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model HomepageContent {
  id                 String   @id @default("homepage")
  heroEyebrow        String   @default("ИНТЕЛЛЕКТУАЛЬНЫЕ ТРАНСПОРТНЫЕ СИСТЕМЫ")
  heroTitle          String   @default("Контроллеры и системы управления дорожным движением")
  heroDescription    String   @default("Разрабатываем оборудование и программные решения для безопасного и эффективного управления городской транспортной инфраструктурой.")
  primaryCtaLabel    String   @default("Подобрать решение")
  primaryCtaHref     String   @default("/solutions")
  secondaryCtaLabel  String   @default("Каталог продукции")
  secondaryCtaHref   String   @default("/products")
  solutionsEyebrow   String   @default("НАПРАВЛЕНИЯ")
  solutionsTitle     String   @default("Всё необходимое для управления движением")
  projectsEyebrow    String   @default("ПРОЕКТЫ")
  projectsTitle      String   @default("Решения, работающие на реальных объектах")
  supportTitle       String   @default("Документы и помощь — в одном месте")
  supportDescription String   @default("Быстрый доступ к руководствам, сертификатам, ПО и актуальным версиям материалов.")
  updatedAt          DateTime @updatedAt
}

model ProductCategory {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  sortOrder   Int               @default(0)
  parentId    String?
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([parentId, sortOrder])
}

model Product {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  model            String                 @unique
  name             String
  shortDescription String
  description      String?
  status           ProductStatus          @default(DRAFT)
  featured         Boolean                @default(false)
  sortOrder        Int                    @default(0)
  seoTitle         String?
  seoDescription   String?
  categoryId       String?
  category         ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  specifications   ProductSpecification[]
  features         ProductFeature[]
  configurations   ProductConfiguration[]
  documents        Document[]
  mediaAssets      MediaAsset[]
  leads            Lead[]
  projects         Project[]
  solutions        Solution[]             @relation("ProductSolutions")
  outgoingRelations ProductRelation[]     @relation("ProductRelationSource")
  incomingRelations ProductRelation[]     @relation("ProductRelationTarget")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, sortOrder])
  @@index([categoryId, status, sortOrder])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  unit      String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductFeature {
  id          String   @id @default(cuid())
  productId   String
  title       String
  description String?
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductConfiguration {
  id          String   @id @default(cuid())
  productId   String
  name        String
  description String?
  sku         String?
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductRelation {
  id              String              @id @default(cuid())
  sourceProductId String
  targetProductId String
  type            ProductRelationType @default(RELATED)
  sortOrder       Int                 @default(0)
  sourceProduct   Product             @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct   Product             @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())

  @@unique([sourceProductId, targetProductId, type])
  @@index([sourceProductId, type, sortOrder])
  @@index([targetProductId])
}

model Solution {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  description      String?
  type             SolutionType  @default(SOLUTION)
  status           ContentStatus @default(DRAFT)
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  imageUrl         String?
  seoTitle         String?
  seoDescription   String?
  projects         Project[]
  products         Product[]     @relation("ProductSolutions")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([type, status])
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  city           String?
  region         String?
  year           Int?
  challenge      String?
  solutionText   String?
  result         String?
  coverImageUrl  String?
  status         ContentStatus @default(DRAFT)
  featured       Boolean       @default(false)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  products       Product[]
  solutions      Solution[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([year])
}

model Document {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        DocumentType
  fileUrl     String
  fileName    String
  version     String?
  language    String       @default("ru")
  mimeType    String?
  fileSize    Int?
  isPublic    Boolean      @default(true)
  publishedAt DateTime?
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type, publishedAt])
  @@index([productId])
  @@index([isPublic, publishedAt])
}

model MediaAsset {
  id              String    @id @default(cuid())
  title           String
  alt             String?
  type            MediaType @default(IMAGE)
  url             String
  storageProvider String    @default("external")
  storageKey      String?
  mimeType        String?
  fileSize        Int?
  width           Int?
  height          Int?
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  isPrimary       Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([type, createdAt])
  @@index([productId, isPrimary, sortOrder])
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  message     String?
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourcePath  String?
  referrer    String?
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  visitorId  String
  sessionId  String?
  path       String
  productId  String?
  documentId String?
  referrer   String?
  source     String?
  device     String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([productId, createdAt])
  @@index([source, createdAt])
  @@index([device, createdAt])
  @@index([sessionId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([entityType, createdAt])
}

model SeoRoute {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  canonical   String?
  indexable   Boolean  @default(true)
  follow      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([indexable, updatedAt])
}

model RedirectRule {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  status    Int      @default(301)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, updatedAt])
}
